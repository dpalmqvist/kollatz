/-- The r = 13 certificate passes `classOk` on every residue below 3^13. -/
theorem certR13_ok : ∀ c < 1594323, classOk 1594323 531441 13330772 10000000 306983457 1073741824 vtreeR13.get c = true := covR13_243

/-- **Lower bound from the r = 13 certificate.** For every `a ≢ 0 (mod 3)` and every `k ≥ 0`, the number of
`n ∈ [1, 2^k a]` with `T^[k] n = a` is at least `(2859/10000) · (13330772/10000000)^k`. -/
theorem preimage_count_lower_bound_R13 (a : ℕ) (_ha : 0 < a) (ha3 : a % 3 ≠ 0) (k : ℕ) :
    (2859 / 10000 : ℝ) * (13330772 / 10000000 : ℝ) ^ k ≤
      ((Finset.Icc 1 (2 ^ k * a)).filter (fun n => T^[k] n = a)).card := by
  have h := lower_bound_of_check (r := 13) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) certR13_ok a ha3 k
  simp only [Nat.cast_ofNat] at h
  have hc : (2859 / 10000 : ℝ) ≤ 306983457 / 1073741824 := by norm_num
  exact (mul_le_mul_of_nonneg_right hc (by positivity)).trans h

/-- The same statement with `T` written out, so that it mentions only Mathlib notions. -/
theorem preimage_count_lower_bound_R13' (a : ℕ) (ha : 0 < a) (ha3 : a % 3 ≠ 0) (k : ℕ) :
    (2859 / 10000 : ℝ) * (13330772 / 10000000 : ℝ) ^ k ≤
      ((Finset.Icc 1 (2 ^ k * a)).filter
        (fun n => (fun m : ℕ => if m % 2 = 0 then m / 2 else (3 * m + 1) / 2)^[k] n = a)).card :=
  preimage_count_lower_bound_R13 a ha ha3 k

end PreimageBound
