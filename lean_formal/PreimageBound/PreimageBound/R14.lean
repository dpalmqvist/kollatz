/-- The r = 14 certificate passes `classOk` on every residue below 3^14. -/
theorem certR14_ok : ∀ c < 4782969, classOk 4782969 1594323 13331664 10000000 305785487 1073741824 vtreeR14.get c = true := covR14_729

/-- **Lower bound from the r = 14 certificate.** For every `a ≢ 0 (mod 3)` and every `k ≥ 0`, the number of
`n ∈ [1, 2^k a]` with `T^[k] n = a` is at least `(2847/10000) · (13331664/10000000)^k`. -/
theorem preimage_count_lower_bound_R14 (a : ℕ) (_ha : 0 < a) (ha3 : a % 3 ≠ 0) (k : ℕ) :
    (2847 / 10000 : ℝ) * (13331664 / 10000000 : ℝ) ^ k ≤
      ((Finset.Icc 1 (2 ^ k * a)).filter (fun n => T^[k] n = a)).card := by
  have h := lower_bound_of_check (r := 14) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) certR14_ok a ha3 k
  simp only [Nat.cast_ofNat] at h
  have hc : (2847 / 10000 : ℝ) ≤ 305785487 / 1073741824 := by norm_num
  exact (mul_le_mul_of_nonneg_right hc (by positivity)).trans h

/-- The same statement with `T` written out, so that it mentions only Mathlib notions. -/
theorem preimage_count_lower_bound_R14' (a : ℕ) (ha : 0 < a) (ha3 : a % 3 ≠ 0) (k : ℕ) :
    (2847 / 10000 : ℝ) * (13331664 / 10000000 : ℝ) ^ k ≤
      ((Finset.Icc 1 (2 ^ k * a)).filter
        (fun n => (fun m : ℕ => if m % 2 = 0 then m / 2 else (3 * m + 1) / 2)^[k] n = a)).card :=
  preimage_count_lower_bound_R14 a ha ha3 k

end PreimageBound
